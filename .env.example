# Copie para .env antes de rodar `make up`. NUNCA commite o .env.

# --- Postgres (local) ---
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm-local-pw
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:litellm-local-pw@postgres:5432/litellm

# --- LiteLLM (gateway) ---
# Chave mestra admin. Em produção vive APENAS no Secret Manager / env do broker.
LITELLM_MASTER_KEY=sk-local-master

# --- Vertex AI (opcional em dev local; o modelo mock funciona sem isso) ---
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-east5

# --- Broker ---
LITELLM_BASE_URL=http://litellm:4000
# URL pública do gateway que o CLI entrega aos clientes (local = localhost)
GATEWAY_PUBLIC_URL=http://localhost:4000
# Domínio corporativo aceito no claim `hd` do Google ID token
BROKER_ALLOWED_DOMAIN=empresa.com
# Budget por usuário (USD) e janela
BROKER_USER_MAX_BUDGET=50
BROKER_USER_BUDGET_DURATION=30d
# SOMENTE DEV: aceita header X-Dev-Email no lugar do token Google
BROKER_DEV_FAKE_AUTH=1
